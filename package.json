{
  "name": "dsh-deepseek-billing",
  "version": "0.5.0",
  "description": "DeepSeek 峰谷计费插件（梁文峰/梁文谷）：只对官方渠道计价，模型跟随官方目录，价格按生效纪元分段，含法定节假日谷时，实时计价当前会话（含子代理），挂载为 DSH 官方右侧栏标签页。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/pricing.test.mjs && node test/client-smoke.test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "billing",
    "peak-valley",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zalpha263/dsh-deepseek-billing.git"
  },
  "homepage": "https://github.com/Zalpha263/dsh-deepseek-billing#readme",
  "bugs": {
    "url": "https://github.com/Zalpha263/dsh-deepseek-billing/issues"
  },
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "test",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ]
}
